# Polaris Agent — copy to .env and fill in values.
# Never commit real secrets.

# Network: testnet | mainnet
STELLAR_NETWORK=testnet

# Horizon REST API (classic payments / account ops)
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC (smart contract invocations)
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Signing key for the agent account (S...). Prefer a dedicated testnet key.
# Fund via Friendbot on testnet: https://friendbot.stellar.org/?addr=<G...>
STELLAR_SECRET_KEY=

# Optional destination for Hello World payment (defaults to agent's own public key)
HELLO_WORLD_DESTINATION=

# Optional payment amount in XLM (default: 0.0000001)
HELLO_WORLD_AMOUNT=0.0000001

# --- Yield data pipeline ---
# Optional API keys / overrides (providers degrade gracefully if unset or unreachable)
BLEND_API_URL=https://api.blend.capital
BLEND_API_KEY=

PHOENIX_API_URL=https://api.soroswap.finance
PHOENIX_API_KEY=

SOROSWAP_API_URL=https://api.soroswap.finance
SOROSWAP_API_KEY=

# Optional Blend pool contract IDs (comma-separated C...) for on-chain rate reads
BLEND_POOL_IDS=
